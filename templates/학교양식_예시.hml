="1155" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>vec F_1</SCRIPT></EQUATION><CHAR>의 종점은 </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="1189377445" Lock="false" NumberingType="Equation" TextFlow="BothSides" TextWrap="Square" ZOrder="211"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="2254" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>(3, 1)</SCRIPT></EQUATION><CHAR>이고, 가는 화살표 </CHAR><EQUATION BaseLine="75" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="1189377446" Lock="false" NumberingType="Equation" TextFlow="BothSides" TextWrap="Square" ZOrder="210"><SIZE Height="1575" HeightRelTo="Absolute" Protect="false" Width="1155" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>vec F_2</SCRIPT></EQUATION><CHAR>의 종점은 </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="1189377447" Lock="false" NumberingType="Equation" TextFlow="BothSides" TextWrap="Square" ZOrder="209"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="2254" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>(1, 2)</SCRIPT></EQUATION><CHAR>이다.</CHAR></TEXT></P><P ParaShape="1" Style="0"><TEXT CharShape="1"><CHAR>격자판의 가로축과 세로축은 검은색 실선으로 굵게 강조되어 있고, 두 축에 한 칸 간격으로 눈금이 표시되어 있다.</CHAR></TEXT></P><P ParaShape="1" Style="0"><TEXT CharShape="1"/></P><P ParaShape="1" Style="0"><TEXT CharShape="1"><EQUATION BaseLine="75" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="1189377448" Lock="false" NumberingType="Equation" TextFlow="BothSides" TextWrap="Square" ZOrder="208"><SIZE Height="1575" HeightRelTo="Absolute" Protect="false" Width="3289" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>vec F_1 + vec F_2</SCRIPT></EQUATION><CHAR>의 크기는? (단, 모눈종이 한 칸의 크기는 </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="1189377449" Lock="false" NumberingType="Equation" TextFlow="BothSides" TextWrap="Square" ZOrder="207"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="1350" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>1 rm {N}</SCRIPT></EQUATION><CHAR>이다.) [4점]</CHAR></TEXT></P><P ParaShape="1" Style="0"><TEXT CharShape="1"><TABLE BorderFill="4" CellSpacing="0" ColCount="11" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1189377476" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="217"><SIZE Height="1666" HeightRelTo="Absolute" Protect="false" Width="31322" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="0" Left="141" Right="141" Top="0"/><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1666" Protect="false" RowAddr="0" RowSpan="1" Width="1020"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="5"/></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1666" Protect="false" RowAddr="0" RowSpan="1" Width="1332"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="2"><CHAR>①</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1666" Protect="false" RowAddr="0" RowSpan="1" Width="4728"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><